# Contoh konfigurasi runtime backend LiveKit. Salin jadi ".env" lalu isi nilainya.
# File .env dibaca otomatis saat start — dicari di working directory lalu di
# sebelah biner. Variabel environment asli selalu menang atas isi file.

# --- Service HTTP -----------------------------------------------------------
# Port listen. Default 8089 (lihat catatan topologi port lokal; 8080 dipakai
# Apache, jadi jangan pakai angka itu).
LIVEKIT_BE_PORT=8089
# CORS. "*" untuk dev; di produksi isi origin dashboard, mis. https://dashboard.greenpark.id
LIVEKIT_ALLOW_ORIGIN=*
# Lokasi file penyimpanan (meeting, peserta, event). Belum Postgres — file JSON.
LIVEKIT_DATA_PATH=data/livekit-data.json

# --- SSO Greenpark (Master Auth :8090) --------------------------------------
# Token dari SSO diverifikasi lewat JWKS; sama polanya dengan backend divisi lain.
AUTH_JWKS_URL=http://localhost:8090/.well-known/jwks.json
AUTH_ISSUER=greenpark-auth
# Nama departemen service ini saat menukar/menandai identitas ke SSO.
LIVEKIT_DEPARTMENT=livekit

# --- Server LiveKit (WebRTC) ------------------------------------------------
# URL signaling. Self-hosted dev: ws://localhost:7880
# LiveKit Cloud: wss://<project>.livekit.cloud
LIVEKIT_URL=ws://localhost:7880

# Alamat LiveKit yang dikirim ke BROWSER. Isi HANYA kalau berbeda dari
# LIVEKIT_URL di atas — yaitu saat LiveKit di-self-host di balik reverse proxy:
# service ini memanggil ws://127.0.0.1:7880 (lokal, tanpa TLS), sedangkan
# halaman https hanya boleh menyambung ke wss://, mis.
#   LIVEKIT_PUBLIC_URL=wss://dahsboard.greenparkgroup.cloud/livekit
# Untuk LiveKit Cloud biarkan kosong (URL-nya sudah wss:// dan bisa diakses dua-duanya).
LIVEKIT_PUBLIC_URL=
# API key & secret dari LiveKit (dev server bawaan: devkey / secret).
# Dipakai untuk menandatangani access token dan memanggil server API
# (room, egress, dispatch agent). Tanpa keduanya, endpoint token/room MENOLAK.
LIVEKIT_API_KEY=
# RAHASIA — jangan pernah di-commit. Untuk produksi minimal 32 karakter.
LIVEKIT_API_SECRET=
# Umur access token join (menit). Default 240 = 4 jam.
LIVEKIT_TOKEN_TTL_MIN=240

# --- Egress (rekaman / streaming RTMP) --------------------------------------
# Folder tujuan hasil rekaman file. Butuh service livekit/egress aktif.
LIVEKIT_RECORD_DIR=recordings

# --- Voice AI Agent ---------------------------------------------------------
# Nama worker LiveKit Agents untuk dispatch eksplisit ke room.
# Kosongkan kalau belum ada worker yang jalan — fitur agent otomatis nonaktif.
LIVEKIT_AGENT_NAME=
